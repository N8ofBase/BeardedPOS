# Copy to services/store-api/.env (git ignores it) to run `npm run dev:store` against the Square Sandbox.
# Leave SQUARE_ENV=offline to use the saved catalog and the checkout preview page instead.
SQUARE_ENV=offline
# From developer.squareup.com > your app > Sandbox > Credentials. Never commit it or paste it in chat.
SQUARE_SANDBOX_ACCESS_TOKEN=
# Optional: the Sandbox location id. Left blank, the account's main location is used.
SQUARE_LOCATION_ID=
