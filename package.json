{
  "name": "bearded-pos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/core",
    "packages/db",
    "packages/store-core",
    "services/api",
    "services/store-api",
    "apps/web",
    "apps/store",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:store": "npm run dev -w apps/store",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:demo": "npm run build -w apps/web",
    "build:store": "npm run build -w apps/store",
    "deploy:demo": "npm run build:demo && npm run deploy:demo -w infra",
    "deploy:prototype": "npm run deploy:prototype -w infra"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
